# Скопируйте в .env или задайте те же переменные в панели хостинга / Docker.
# Токен: Настройки сообщества → Работа с API → ключ с правами на сообщения и Long Poll.
# ID группы: число из club123456789 → 123456789 (без минуса).

VK_GROUP_TOKEN=
VK_GROUP_ID=

# Необязательно: файл SQLite (на хостинге укажите путь на постоянный диск / том)
# DATABASE_PATH=/data/bot_data.sqlite3

# Необязательно: версия VK API (по умолчанию 5.199)
# VK_API_VERSION=5.199
